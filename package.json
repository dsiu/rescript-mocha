{
  "name": "@dsiu/rescript-mocha",
  "version": "0.11.0",
  "description": "ReScript bindings for mocha",
  "repository": {
    "type": "git",
    "url": "git://github.com/dsiu/rescript-mocha.git"
  },
  "homepage": "https://github.com/dsiu/rescript-mocha",
  "bugs": "https://github.com/dsiu/rescript-mocha/issues",
  "scripts": {
    "clean": "rescript clean",
    "build": "rescript",
    "watch": "rescript watch",
    "start": "rescript watch",
    "test": "rescript && mocha",
    "prepublishOnly": "yarn clean && yarn test"
  },
  "mocha": {
    "recursive": true,
    "reporter": "progress",
    "spec": [
      "test"
    ]
  },
  "keywords": [
    "rescript",
    "mocha",
    "testing",
    "test"
  ],
  "author": "Andrew Herron",
  "contributors": [
    "Hongbo Zhang",
    "Risto Stevcev",
    "dsiu"
  ],
  "license": "MIT",
  "files": [
    "src/**/*.res",
    "src/**/*.resi",
    "src/**/*.res.mjs",
    "rescript.json",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "rescript": "^12.3.0"
  },
  "dependencies": {
    "mocha": "^10.4.0"
  },
  "type": "module",
  "packageManager": "yarn@4.17.0"
}
