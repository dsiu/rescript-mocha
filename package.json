{
  "name": "rescript-mocha",
  "version": "0.9.0",
  "description": "ReScript bindings for mocha",
  "repository": {
    "type": "git",
    "url": "git://github.com/TheSpyder/rescript-mocha.git"
  },
  "homepage": "https://github.com/TheSpyder/rescript-mocha",
  "bugs": "https://github.com/TheSpyder/rescript-mocha/issues",
  "scripts": {
    "clean": "rescript clean",
    "build": "rescript",
    "watch": "rescript build -w",
    "start": "rescript build -w",
    "test": "rescript && mocha",
    "prepublishOnly": "yarn clean && yarn test"
  },
  "mocha": {
    "recursive": true,
    "reporter": "progress",
    "spec": [
      "test"
    ]
  },
  "keywords": [
    "BuckleScript",
    "reason",
    "ReScript"
  ],
  "author": "Andrew Herron",
  "contributors": [
    "Hongbo Zhang",
    "Risto Stevcev"
  ],
  "license": "MIT",
  "devDependencies": {
    "rescript": "^12.0.0-alpha.14"
  },
  "dependencies": {
    "mocha": "^9.2.2"
  },
  "packageManager": "yarn@4.9.2+sha512.1fc009bc09d13cfd0e19efa44cbfc2b9cf6ca61482725eb35bbc5e257e093ebf4130db6dfe15d604ff4b79efd8e1e8e99b25fa7d0a6197c9f9826358d4d65c3c"
}
